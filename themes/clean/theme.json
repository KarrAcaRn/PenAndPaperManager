{
  "$schema": "../theme.schema.json",
  "manifestVersion": 1,
  "id": "clean",
  "name": "Clean",
  "author": "Pen & Paper Manager",
  "version": "1.0.0",
  "description": "Minimalistisch und hell: viel Weißraum, dünne neutrale Linien, dezente Schatten, serifenlose Schrift, ohne Zierrahmen. Immer hell.",
  "license": "MIT; Vorschau (preview.svg) selbst erstellt; nutzt nur Systemschriften",
  "preview": "preview.svg",
  "css": "style.css",
  "tokens": {
    "color-scheme": "light",
    "color-bg": "#f6f7f9",
    "color-surface": "#ffffff",
    "color-surface-muted": "#f1f3f5",
    "color-border": "#e1e4e8",
    "color-text": "#1f2328",
    "color-text-muted": "#59636e",
    "color-link": "#1d4ed8",
    "color-accent": "#2563eb",
    "color-accent-text": "#ffffff",
    "color-accent-hover": "rgba(255, 255, 255, 0.2)",
    "color-danger": "#c62828",
    "color-highlight": "rgba(250, 204, 21, 0.45)",
    "color-selection": "rgba(37, 99, 235, 0.14)",
    "border-width": "1px",
    "border-style": "solid",
    "border-width-strong": "3px",
    "outline-width": "2px",
    "border-radius": "6px",
    "border-radius-small": "3px",
    "radius-pill": "999px",
    "shadow-surface": "0 1px 2px rgba(16, 24, 40, 0.05), 0 1px 3px rgba(16, 24, 40, 0.06)",
    "shadow-popup": "0 8px 24px rgba(16, 24, 40, 0.12)",
    "frame-image": "none",
    "frame-slice": "1",
    "frame-width": "0px",
    "frame-outset": "0px",
    "frame-repeat": "stretch",
    "frame-line": "inset 0 0 0 var(--border-width) var(--color-border)",
    "frame-padding": "1rem",
    "bg-image": "none",
    "surface-image": "none",
    "font-body": "Inter, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, system-ui, sans-serif",
    "font-heading": "var(--font-body)",
    "font-mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "sheet-shadow": "0 2px 12px rgba(16, 24, 40, 0.12)"
  }
}
