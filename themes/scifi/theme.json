{
  "$schema": "../theme.schema.json",
  "manifestVersion": 1,
  "id": "scifi",
  "name": "SciFi",
  "author": "Pen & Paper Manager",
  "version": "1.0.0",
  "description": "Dunkles Cockpit mit Neon-Akzenten in Cyan und Magenta: abgeschrägte Ecken, leuchtende Kanten, technische Schrift. Immer dunkel.",
  "license": "MIT; Grafiken (frame.svg, grid.svg, preview.svg) selbst erstellt; Schriften Orbitron, Exo 2 und Share Tech Mono unter SIL Open Font License 1.1 (fonts/OFL-*.txt)",
  "preview": "preview.svg",
  "css": "style.css",
  "tokens": {
    "color-scheme": "dark",
    "color-bg": "#070b14",
    "color-surface": "#0e1626",
    "color-surface-muted": "#14203a",
    "color-border": "#1f6f8b",
    "color-text": "#dff6ff",
    "color-text-muted": "#8fb2c4",
    "color-link": "#4fe3ff",
    "color-accent": "#00d9f5",
    "color-accent-text": "#04121a",
    "color-accent-hover": "rgba(4, 18, 26, 0.2)",
    "color-danger": "#ff5ca8",
    "color-highlight": "rgba(255, 46, 196, 0.4)",
    "color-selection": "rgba(0, 217, 245, 0.22)",
    "border-width": "1px",
    "border-style": "solid",
    "border-width-strong": "3px",
    "outline-width": "2px",
    "border-radius": "0px",
    "border-radius-small": "0px",
    "radius-pill": "0px",
    "shadow-surface": "0 0 transparent",
    "shadow-popup": "0 0 0 1px #1f6f8b, 0 0 22px rgba(0, 217, 245, 0.3)",
    "frame-image": "url('frame.svg')",
    "frame-slice": "16",
    "frame-width": "24px",
    "frame-outset": "calc(var(--frame-width) / 2)",
    "frame-repeat": "stretch",
    "frame-line": "inset 0 0 18px rgba(0, 217, 245, 0.12)",
    "frame-padding": "calc(var(--frame-width) / 2 + 0.5rem)",
    "bg-image": "url('grid.svg')",
    "surface-image": "linear-gradient(180deg, rgba(0, 217, 245, 0.06), transparent 45%)",
    "font-body": "'Exo 2', 'Segoe UI', Roboto, system-ui, sans-serif",
    "font-heading": "Orbitron, 'Exo 2', 'Segoe UI', sans-serif",
    "font-mono": "'Share Tech Mono', ui-monospace, monospace",
    "sheet-shadow": "0 0 0 1px #1f6f8b, 0 0 28px rgba(0, 217, 245, 0.35)"
  }
}
