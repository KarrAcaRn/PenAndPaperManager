{
  "$schema": "../theme.schema.json",
  "manifestVersion": 1,
  "id": "fantasy",
  "name": "Fantasy",
  "author": "Pen & Paper Manager",
  "version": "1.0.0",
  "description": "Pergament und dunkles Holz mit Goldeinlagen: verzierter Holzrahmen mit Rosetten, Zierschrift für Überschriften, Garamond für den Text. Immer hell.",
  "license": "MIT; Grafiken (frame.svg, parchment.svg, preview.svg) selbst erstellt; Schriften Cinzel und EB Garamond unter SIL Open Font License 1.1 (fonts/OFL-*.txt)",
  "preview": "preview.svg",
  "css": "style.css",
  "tokens": {
    "color-scheme": "light",
    "color-bg": "#ecdfc0",
    "color-surface": "#f8efd9",
    "color-surface-muted": "#efe2c2",
    "color-border": "#b08a5c",
    "color-text": "#2e1f12",
    "color-text-muted": "#654a30",
    "color-link": "#7a2e12",
    "color-accent": "#6b3415",
    "color-accent-text": "#fbecc0",
    "color-accent-hover": "rgba(251, 236, 192, 0.22)",
    "color-danger": "#9b1c1c",
    "color-highlight": "rgba(214, 170, 60, 0.45)",
    "color-selection": "rgba(201, 151, 47, 0.25)",
    "border-width": "1px",
    "border-style": "solid",
    "border-width-strong": "3px",
    "outline-width": "2px",
    "border-radius": "4px",
    "border-radius-small": "2px",
    "radius-pill": "999px",
    "shadow-surface": "0 1px 3px rgba(74, 47, 23, 0.25)",
    "shadow-popup": "0 6px 18px rgba(46, 31, 18, 0.35)",
    "frame-image": "url('frame.svg')",
    "frame-slice": "32",
    "frame-width": "28px",
    "frame-outset": "calc(var(--frame-width) / 2)",
    "frame-repeat": "round",
    "frame-line": "0 0 transparent",
    "frame-padding": "calc(var(--frame-width) / 2 + 0.5rem)",
    "bg-image": "url('parchment.svg')",
    "surface-image": "url('parchment.svg')",
    "font-body": "'EB Garamond', Garamond, 'Palatino Linotype', 'Book Antiqua', Georgia, serif",
    "font-heading": "Cinzel, 'Trajan Pro', 'Palatino Linotype', Georgia, serif",
    "font-mono": "ui-monospace, 'Courier New', monospace",
    "sheet-paper": "#fbf4e2",
    "sheet-ink": "#2e1f12",
    "sheet-line": "#9c8463",
    "sheet-faded": "#d4c3a2",
    "sheet-focus": "#f3e4bf",
    "sheet-accent": "#6b3415",
    "sheet-on-accent": "#fbecc0",
    "sheet-logo": "#4a2f17",
    "sheet-shadow": "0 4px 24px rgba(46, 31, 18, 0.45)"
  }
}
