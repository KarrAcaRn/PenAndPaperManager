{
  "$schema": "../theme.schema.json",
  "manifestVersion": 1,
  "id": "default",
  "name": "Standard",
  "author": "Pen & Paper Manager",
  "version": "1.0.0",
  "description": "Warme Papiertöne mit Zweigrahmen; folgt dem hellen bzw. dunklen Farbschema des Systems. Basis-Theme: seine Werte gelten für alle Tokens, die ein anderes Theme nicht setzt.",
  "license": "MIT; Zweigrahmen (vine-frame.svg) selbst erstellt",
  "tokens": {
    "color-scheme": "light",
    "color-bg": "#f6f1e7",
    "color-surface": "#fffdf8",
    "color-surface-muted": "var(--color-bg)",
    "color-border": "#ddd3c0",
    "color-text": "#2b2620",
    "color-text-muted": "#766b5c",
    "color-link": "var(--color-accent)",
    "color-accent": "#8a3b12",
    "color-accent-text": "#fff",
    "color-accent-hover": "rgba(255, 255, 255, 0.2)",
    "color-danger": "#a3261f",
    "color-highlight": "color-mix(in srgb, var(--color-accent) 25%, transparent)",
    "color-selection": "color-mix(in srgb, var(--color-accent) 15%, transparent)",
    "border-width": "1px",
    "border-style": "solid",
    "border-width-strong": "3px",
    "outline-width": "2px",
    "border-radius": "8px",
    "border-radius-small": "2px",
    "radius-pill": "999px",
    "shadow-surface": "0 0 transparent",
    "shadow-popup": "0 4px 14px rgba(0, 0, 0, 0.18)",
    "frame-image": "url('vine-frame.svg')",
    "frame-slice": "32",
    "frame-width": "33px",
    "frame-outset": "calc(var(--frame-width) / 2)",
    "frame-repeat": "round",
    "frame-line": "inset 0 0 0 var(--border-width) var(--color-border)",
    "frame-padding": "calc(var(--frame-width) / 2 + 0.4rem)",
    "bg-image": "none",
    "surface-image": "none",
    "font-body": "system-ui, sans-serif",
    "font-heading": "var(--font-body)",
    "font-mono": "ui-monospace, monospace",
    "sheet-paper": "#fff",
    "sheet-ink": "#1a1a1a",
    "sheet-line": "#9a9a9a",
    "sheet-faded": "#c9c9c9",
    "sheet-focus": "#eef3fa",
    "sheet-accent": "#4a72a8",
    "sheet-on-accent": "#fff",
    "sheet-logo": "#111",
    "sheet-shadow": "0 4px 24px rgba(0, 0, 0, 0.45)",
    "sheet-font": "'Roboto Condensed', 'Arial Narrow', Arial, sans-serif",
    "sheet-font-heading": "Oswald, 'Arial Narrow', Arial, sans-serif"
  },
  "darkTokens": {
    "color-scheme": "dark",
    "color-bg": "#1d1a17",
    "color-surface": "#27231f",
    "color-border": "#423b33",
    "color-text": "#ece5d9",
    "color-text-muted": "#a39887",
    "color-accent": "#e08a4f",
    "color-accent-text": "#1d1a17",
    "color-danger": "#ef7d74"
  }
}
