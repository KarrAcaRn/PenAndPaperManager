# Beispielkonfiguration – Werte als Umgebungsvariablen setzen (die App liest keine .env-Datei automatisch).

PORT=3000
HOST=127.0.0.1
DB_PATH=data/app.db
# Eigene Themes des Seitenbetreibers (Standard: themes neben der Datenbank)
# THEMES_DIR=data/themes
# Theme für alle ohne eigene Wahl (Standard: default; fehlt das Theme, gilt default)
# DEFAULT_THEME=default

# --- E-Mail-Versand (Login-Codes) ---
# MAIL_TRANSPORT: "smtp" oder "log". Ohne Angabe: smtp, wenn SMTP_HOST gesetzt ist; sonst "log" außerhalb
# von NODE_ENV=production. "log" verschickt nichts, sondern schreibt Empfänger und Code ins Server-Log
# (nur für Entwicklung/Test – in Produktion ausdrücklich gesetzt, landen Codes im Log!).
# In Produktion ohne SMTP-Konfiguration schlägt der Versand fehl.
# MAIL_TRANSPORT=log

SMTP_HOST=smtp.example.org
# 587 = STARTTLS (Standard), 465 = TLS
SMTP_PORT=587
# SMTP_SECURE=true|false – Standard: true nur bei Port 465
SMTP_USER=login@example.org
SMTP_PASS=geheim
# Absender; Standard ist SMTP_USER
MAIL_FROM="Pen & Paper Manager <login@example.org>"
